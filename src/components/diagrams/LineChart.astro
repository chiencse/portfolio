---
// Small dependency-free SVG line chart for blog posts. Colours come from theme tokens.
type Series = { name: string; values: number[]; cls: string; dashed?: boolean; end?: string };
type Band = { from: number; to: number; label: string };
type HLine = { v: number; label: string; cls?: string };

interface Props {
  series: Series[];
  xTicks?: { i: number; label: string }[];
  yTicks?: { v: number; label: string }[];
  yMin?: number;
  yMax?: number;
  height?: number;
  bands?: Band[];
  hLines?: HLine[];
  legend?: boolean;
  label: string;
}

const {
  series,
  xTicks = [],
  yTicks = [],
  height = 300,
  bands = [],
  hLines = [],
  legend = true,
  label,
} = Astro.props;

const W = 720;
const pad = { l: 64, r: 120, t: legend ? 40 : 16, b: 34 };
const n = Math.max(...series.map((s) => s.values.length));
const all = series.flatMap((s) => s.values);
const yMin = Astro.props.yMin ?? Math.min(...all);
const yMax = Astro.props.yMax ?? Math.max(...all);
const x = (i: number) => pad.l + (i / (n - 1)) * (W - pad.l - pad.r);
const y = (v: number) => pad.t + (1 - (v - yMin) / (yMax - yMin)) * (height - pad.t - pad.b);
const path = (vals: number[]) => vals.map((v, i) => `${i ? 'L' : 'M'}${x(i).toFixed(1)},${y(v).toFixed(1)}`).join(' ');
---

<svg viewBox={`0 0 ${W} ${height}`} role="img" aria-label={label}>
  {
    bands.map((b, i) => (
      <g>
        <rect x={x(b.from)} y={pad.t} width={x(b.to) - x(b.from)} height={height - pad.t - pad.b} class="band" />
        <text x={(x(b.from) + x(b.to)) / 2} y={pad.t + 16 + (i % 2) * 16} text-anchor="middle" class="s">
          {b.label}
        </text>
      </g>
    ))
  }
  {
    yTicks.map((t) => (
      <g>
        <line x1={pad.l} x2={W - pad.r} y1={y(t.v)} y2={y(t.v)} class="grid" />
        <text x={pad.l - 8} y={y(t.v) + 4} text-anchor="end" class="s mono">
          {t.label}
        </text>
      </g>
    ))
  }
  {
    xTicks.map((t) => (
      <text x={x(t.i)} y={height - 10} text-anchor="middle" class="s mono">
        {t.label}
      </text>
    ))
  }
  {
    hLines.map((h) => (
      <g>
        <line x1={pad.l} x2={W - pad.r} y1={y(h.v)} y2={y(h.v)} class={`${h.cls ?? 'line-muted'} dashed`} style="stroke-width:1.5" />
        <text x={W - pad.r + 6} y={y(h.v) + 4} class="s">
          {h.label}
        </text>
      </g>
    ))
  }
  {
    series.map((s) => (
      <g>
        <path d={path(s.values)} class={`line-${s.cls}${s.dashed ? ' dashed' : ''}`} />
        {s.end && (
          <text x={x(s.values.length - 1) + 8} y={y(s.values[s.values.length - 1]) + 4} class="c mono">
            {s.end}
          </text>
        )}
      </g>
    ))
  }
  {
    legend &&
      series.map((s, i) => (
        <g>
          <rect x={pad.l + i * 190} y="12" width="14" height="4" rx="2" class={`swatch-${s.cls}`} />
          <text x={pad.l + i * 190 + 20} y="18" class="s">
            {s.name}
          </text>
        </g>
      ))
  }
</svg>
