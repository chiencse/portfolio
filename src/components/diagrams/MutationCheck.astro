  <rect x="476" y="60" width="228" height="80" rx="12" class="box-accent"></rect>
  <text x="590" y="94" text-anchor="middle" class="t mono fill-accent">PASS</text>
  <text x="590" y="114" text-anchor="middle" class="s">✓ trông vẫn ổn…</text>

  <rect x="236" y="152" width="228" height="80" rx="12" class="box-accent"></rect>
  <text x="350" y="186" text-anchor="middle" class="t mono fill-accent">FAIL</text>
  <text x="350" y="206" text-anchor="middle" class="s">✓ bắt được lỗi</text>

  <rect x="476" y="152" width="228" height="80" rx="12" class="box-warn"></rect>
  <text x="590" y="186" text-anchor="middle" class="t mono fill-warn">PASS</text>
  <text x="590" y="206" text-anchor="middle" class="s">✕ để lọt lỗi</text>

  <text x="360" y="262" text-anchor="middle" class="s">Chỉ chạy trường hợp đúng thì hai evaluator giống hệt nhau — mutation mới lộ ra khác biệt</text>
