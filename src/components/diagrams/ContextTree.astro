<svg viewBox="0 0 720 300" role="img" aria-label="Cây context: hủy context cha thì mọi context con bị hủy theo, context anh em không bị ảnh hưởng">
  <defs>
    <marker id="ct-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" class="head"></path>
    </marker>
    <marker id="ct-arrow-warn" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" class="head-warn"></path>
    </marker>
  </defs>

  <rect x="280" y="12" width="160" height="44" rx="10" class="box"></rect>
  <text x="360" y="39" text-anchor="middle" class="t mono">Background()</text>

  <rect x="96" y="96" width="248" height="54" rx="10" class="box-warn"></rect>
  <text x="220" y="119" text-anchor="middle" class="t mono">WithTimeout(2s)</text>
  <text x="220" y="139" text-anchor="middle" class="s">request handler · cancel() / hết giờ</text>

  <rect x="420" y="96" width="232" height="54" rx="10" class="box"></rect>
  <text x="536" y="119" text-anchor="middle" class="t mono">WithCancel</text>
  <text x="536" y="139" text-anchor="middle" class="s">job nền · vẫn chạy bình thường</text>

  <line x1="330" y1="56" x2="240" y2="94" class="edge" marker-end="url(#ct-arrow)"></line>
  <line x1="390" y1="56" x2="510" y2="94" class="edge" marker-end="url(#ct-arrow)"></line>

  <rect x="16" y="196" width="196" height="54" rx="10" class="box-warn"></rect>
  <text x="114" y="219" text-anchor="middle" class="t mono">WithCancel</text>
  <text x="114" y="239" text-anchor="middle" class="s">query DB → dừng</text>

  <rect x="232" y="196" width="220" height="54" rx="10" class="box-warn"></rect>
  <text x="342" y="219" text-anchor="middle" class="t mono">WithTimeout(500ms)</text>
  <text x="342" y="239" text-anchor="middle" class="s">gọi API ngoài → dừng</text>

  <line x1="190" y1="150" x2="130" y2="194" class="edge-warn flow" marker-end="url(#ct-arrow-warn)"></line>
  <line x1="250" y1="150" x2="320" y2="194" class="edge-warn flow" marker-end="url(#ct-arrow-warn)"></line>
  <text x="560" y="214" text-anchor="middle" class="c fill-warn">ctx.Done() đóng</text>
  <text x="560" y="234" text-anchor="middle" class="s">ctx.Err() = DeadlineExceeded</text>
  <text x="560" y="252" text-anchor="middle" class="s">hoặc Canceled</text>

  <text x="360" y="290" text-anchor="middle" class="s">Hủy lan từ cha xuống con — không bao giờ ngược lên cha hay sang anh em</text>
</svg>
