---
interface Props {
  caption?: string;
}

const { caption } = Astro.props;
---

<figure class="not-prose my-10">
  <div class="diagram overflow-x-auto rounded-2xl border border-line bg-surface p-4 sm:p-6">
    <div class="min-w-[560px]">
      <slot />
    </div>
  </div>
  {caption && <figcaption class="mt-3 text-center text-sm text-pretty text-muted">{caption}</figcaption>}
</figure>
