<svg viewBox="0 0 720 272" role="img" aria-label="Ma trận kiểm evaluator: chỉ khi chạy luật sai mới thấy evaluator nào bị mù">
  <!-- Column headers -->
  <text x="350" y="40" text-anchor="middle" class="t">Evaluator tốt</text>
  <text x="590" y="40" text-anchor="middle" class="t">Evaluator “mù”</text>

  <!-- Row headers -->
  <rect x="12" y="60" width="210" height="80" rx="12" class="box"></rect>
  <text x="117" y="94" text-anchor="middle" class="t">Luật đúng</text>
  <text x="117" y="114" text-anchor="middle" class="s">output chuẩn</text>

  <rect x="12" y="152" width="210" height="80" rx="12" class="box-warn"></rect>
  <text x="117" y="186" text-anchor="middle" class="t">Luật sai (mutation)</text>
  <text x="117" y="206" text-anchor="middle" class="s">cố tình cài lỗi</text>

  <!-- Cells -->
  <rect x="236" y="60" width="228" height="80" rx="12" class="box-accent"></rect>
