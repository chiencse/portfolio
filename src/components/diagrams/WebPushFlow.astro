<svg viewBox="0 0 720 330" role="img" aria-label="Luồng Web Push: trình duyệt đăng ký với dịch vụ push và gửi subscription về server; server mã hoá và ký VAPID rồi gửi qua dịch vụ push; service worker trên điện thoại hiện thông báo">
  <defs>
    <marker id="wp-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" class="head"></path>
    </marker>
    <marker id="wp-arrow-accent" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" class="head-accent"></path>
    </marker>
  </defs>

  <!-- lanes -->
  <rect x="16" y="20" width="200" height="56" rx="12" class="box-info"></rect>
  <text x="116" y="44" text-anchor="middle" class="t">Server của bạn</text>
  <text x="116" y="63" text-anchor="middle" class="s mono">khoá VAPID riêng</text>

  <rect x="260" y="20" width="200" height="56" rx="12" class="box-alt"></rect>
  <text x="360" y="44" text-anchor="middle" class="t">Dịch vụ push</text>
  <text x="360" y="63" text-anchor="middle" class="s">FCM · Apple · Mozilla</text>

  <rect x="504" y="20" width="200" height="56" rx="12" class="box"></rect>
  <text x="604" y="44" text-anchor="middle" class="t">Điện thoại</text>
  <text x="604" y="63" text-anchor="middle" class="s">service worker</text>

  <line x1="116" y1="76" x2="116" y2="316" class="edge" stroke-dasharray="4 5"></line>
  <line x1="360" y1="76" x2="360" y2="316" class="edge" stroke-dasharray="4 5"></line>
  <line x1="604" y1="76" x2="604" y2="316" class="edge" stroke-dasharray="4 5"></line>

  <!-- 1. subscribe -->
  <text x="20" y="104" class="s mono fill-accent">① đăng ký</text>
  <line x1="602" y1="114" x2="362" y2="114" class="edge" marker-end="url(#wp-arrow)"></line>
  <text x="482" y="108" text-anchor="middle" class="s">subscribe(applicationServerKey)</text>
  <line x1="362" y1="136" x2="602" y2="136" class="edge" marker-end="url(#wp-arrow)"></line>
  <text x="482" y="152" text-anchor="middle" class="s">endpoint URL riêng của máy</text>
  <line x1="602" y1="176" x2="118" y2="176" class="edge" marker-end="url(#wp-arrow)"></line>
  <text x="360" y="170" text-anchor="middle" class="s">POST subscription = endpoint + p256dh + auth</text>

  <!-- 2. send -->
  <text x="20" y="214" class="s mono fill-accent">② gửi tin</text>
  <rect x="24" y="222" width="184" height="40" rx="8" class="box-accent"></rect>
  <text x="116" y="240" text-anchor="middle" class="s">mã hoá RFC 8291</text>
  <text x="116" y="255" text-anchor="middle" class="s">+ ký JWT VAPID (RFC 8292)</text>
  <line x1="208" y1="244" x2="358" y2="244" class="edge-accent flow" marker-end="url(#wp-arrow-accent)"></line>
  <text x="283" y="236" text-anchor="middle" class="s">POST endpoint</text>
  <line x1="362" y1="276" x2="602" y2="276" class="edge-accent flow" marker-end="url(#wp-arrow-accent)"></line>
  <text x="482" y="270" text-anchor="middle" class="s">kết nối thường trực sẵn có</text>
  <rect x="520" y="284" width="168" height="30" rx="8" class="box-accent"></rect>
  <text x="604" y="304" text-anchor="middle" class="s">giải mã → showNotification()</text>
</svg>
