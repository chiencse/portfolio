---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import type { Project } from '@/data/site';

interface Props {
  project: Project;
  /** Large two-column card used for the first project. */
  featured?: boolean;
}

const { project, featured = false } = Astro.props;
---

<article
  class:list={['card group flex h-full flex-col overflow-hidden', featured && 'md:grid md:grid-cols-[1.1fr_1fr]']}
  data-tilt
>
  <div
    class:list={[
      'relative aspect-[16/9] overflow-hidden border-b border-line bg-surface-2',
      featured && 'md:aspect-auto md:min-h-80 md:border-r md:border-b-0',
    ]}
  >
    {project.image ? (
      <Image
        src={project.image}
        alt={`Screenshot of ${project.name}`}
        widths={[480, 720, 960, 1280]}
        sizes={featured ? '(min-width: 768px) 520px, 100vw' : '(min-width: 1024px) 320px, (min-width: 768px) 360px, 100vw'}
        class="absolute inset-0 size-full object-cover object-top transition-transform duration-700 group-hover:scale-[1.05]"
      />
    ) : (
      <div class="absolute inset-0 grid place-items-center bg-[radial-gradient(var(--line)_1px,transparent_1px)] [background-size:16px_16px] p-5 sm:p-8">
        <div class="absolute -top-10 -right-10 size-48 rounded-full bg-accent-2/25 blur-3xl" />
        <div class="absolute -bottom-12 left-6 size-40 rounded-full bg-accent/25 blur-3xl" />
        <div class="relative w-full max-w-md overflow-hidden rounded-xl border border-line bg-bg/80 shadow-2xl shadow-black/20 backdrop-blur transition-transform duration-500 group-hover:-translate-y-1">
          <div class="flex items-center gap-1.5 border-b border-line px-3 py-2">
            <span class="size-2.5 rounded-full bg-[#ff5f57]" />
            <span class="size-2.5 rounded-full bg-[#febc2e]" />
            <span class="size-2.5 rounded-full bg-[#28c840]" />
            <span class="ml-2 font-mono text-[0.7rem] text-muted">{project.name.toLowerCase().replace(/\s+/g, '-')}</span>
          </div>
          <div class="space-y-1.5 p-4 font-mono text-[0.8rem] leading-relaxed sm:text-sm">
            {project.terminal?.map((line, n) => (
              <p class:list={['text-pretty', n === 0 ? 'text-muted' : 'text-accent']}>
                <span class="text-accent-2 select-none">{n === 0 ? '› ' : '  '}</span>
                {line}
              </p>
            ))}
          </div>
        </div>
      </div>
    )}
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-bg/40 to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100" />
  </div>
  <div class="flex flex-1 flex-col p-6 sm:p-7">
    <div class="mb-2 flex flex-wrap items-center gap-2">
      {project.kind && <p class="eyebrow">{project.kind}</p>}
      {project.award && (
        <span class="inline-flex items-center gap-1.5 rounded-full border border-accent/40 bg-accent-soft px-2.5 py-0.5 text-xs font-semibold text-accent">
          <Icon name="award" size={14} />
          {project.award}
        </span>
      )}
    </div>
    <h3 class="text-xl font-semibold tracking-tight">{project.name}</h3>
    <p class="mt-3 text-muted text-pretty">{project.description}</p>
    {project.contributions && (
      <div class="mt-4">
        <p class="font-mono text-[0.7rem] tracking-wider text-muted uppercase">My part</p>
        <ul class="mt-2 space-y-2 text-[0.95rem]">
          {project.contributions.map((c) => (
            <li class="relative pl-5 text-pretty before:absolute before:top-[0.7em] before:left-0 before:h-px before:w-2.5 before:bg-accent">
              {c}
            </li>
          ))}
        </ul>
      </div>
    )}
    <div class="flex-1" />
    <ul class="mt-5 flex flex-wrap gap-1.5" aria-label="Tech stack">
      {project.tags.map((tag) => (
        <li class="chip">{tag}</li>
      ))}
    </ul>
    <div class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-sm font-medium">
      {project.repo && (
        <a href={project.repo} class="inline-flex items-center gap-1.5 transition-colors hover:text-accent">
          <Icon name="github" size={16} /> Source
        </a>
      )}
      {project.demo && (
        <a href={project.demo} class="inline-flex items-center gap-1.5 transition-colors hover:text-accent">
          Live demo <Icon name="arrow-up-right" size={15} />
        </a>
      )}
      {project.links?.map((link) => (
        <a href={link.href} class="inline-flex items-center gap-1.5 transition-colors hover:text-accent">
          {link.label} <Icon name="arrow-up-right" size={15} />
        </a>
      ))}
    </div>
  </div>
</article>
