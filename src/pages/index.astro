---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import PostCard from '@/components/PostCard.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import avatar from '@/assets/images/avatar.jpg';
import { profile, facts, experiences, projects, publications, authorName, skills } from '@/data/site';
import { getPosts, url } from '@/lib/utils';

const latestPosts = (await getPosts()).slice(0, 3);
const [featuredProject, ...otherProjects] = projects;
const typedWords = ['backend systems', 'REST APIs', 'LLM pipelines', 'internal platforms', 'web apps'];
const marqueeItems = [...new Set(skills.flatMap((g) => g.items))];
---

<Base>
  <!-- Hero -->
  <section class="container-page grid items-center gap-12 pt-14 pb-16 sm:pt-20 md:grid-cols-[1fr_auto] md:gap-16 md:pt-28 md:pb-24">
    <div class="order-2 md:order-1">
      <p class="mb-6 inline-flex items-center gap-2 rounded-full border border-line bg-glass px-3 py-1 font-mono text-xs text-muted backdrop-blur-sm" data-reveal>
        <span class="relative flex size-2">
          <span class="absolute inline-flex size-full animate-ping rounded-full bg-accent opacity-60"></span>
          <span class="relative inline-flex size-2 rounded-full bg-accent"></span>
        </span>
        {profile.role} @ {profile.company} · {profile.location}
      </p>
      <h1 class="text-4xl leading-[1.08] font-bold tracking-tight text-balance sm:text-6xl" data-reveal style="--reveal-delay:80ms">
        Hi, I'm <span class="text-gradient">{profile.name}</span>.
        <span class="mt-1 block text-muted">{profile.tagline}</span>
      </h1>
      <p class="mt-6 font-mono text-sm text-muted sm:text-base" data-reveal style="--reveal-delay:160ms">
        <span class="text-accent">~$</span> building{" "}
        <span class="text-ink" data-typed={JSON.stringify(typedWords)}>{typedWords[0]}</span><span class="caret" aria-hidden="true"></span>
      </p>
      <p class="mt-5 max-w-xl text-lg text-muted text-pretty" data-reveal style="--reveal-delay:220ms">
        {profile.intro}
      </p>
      <div class="mt-9 flex flex-wrap items-center gap-3" data-reveal style="--reveal-delay:280ms">
        <a href={url('#projects')} class="btn-primary">
          See my work
          <Icon name="arrow-right" size={16} />
        </a>
        <a href={url('blog/')} class="btn-ghost">Read the blog</a>
        <a href={profile.github} class="btn-ghost" aria-label="GitHub profile">
          <Icon name="github" size={16} />
          <span class="sr-only sm:not-sr-only">GitHub</span>
        </a>
      </div>
    </div>

    <div class="order-1 md:order-2" data-reveal>
      <div class="glow-ring mx-auto w-44 rounded-[1.75rem] sm:w-56 md:w-64">
        <Image
          src={avatar}
          alt={`Portrait of ${profile.name}`}
          width={512}
          widths={[256, 384, 512]}
          sizes="(min-width: 768px) 256px, (min-width: 640px) 224px, 176px"
          loading="eager"
          fetchpriority="high"
          class="relative aspect-[4/5] w-full rounded-[1.75rem] bg-surface object-cover object-[50%_30%]"
        />
      </div>
    </div>
  </section>

  <!-- Tech marquee -->
  <div class="marquee overflow-hidden border-y border-line bg-glass py-4 backdrop-blur-sm" aria-hidden="true">
    <ul class="marquee-track flex w-max font-mono text-sm whitespace-nowrap text-muted">
      {
        [...marqueeItems, ...marqueeItems].map((item) => (
          <li class="flex items-center gap-10 pr-10">
            {item}
            <span class="text-accent">✦</span>
          </li>
        ))
      }
    </ul>
  </div>

  <!-- About -->
  <section id="about" class="container-page scroll-mt-20 py-16 sm:py-24">
    <SectionHeading index="01" label="About" title="Software engineer, building with AI." />
    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr] md:gap-16">
      <div class="space-y-5 text-lg leading-relaxed text-muted text-pretty" data-reveal>
        {profile.about.map((p) => <p>{p}</p>)}
      </div>
      <div data-reveal style="--reveal-delay:100ms">
        <dl class="grid grid-cols-2 gap-3">
          {
            facts.map((fact, i) => (
              <div class:list={['card p-5', i === facts.length - 1 && facts.length % 2 === 1 && 'col-span-2']}>
                <dt class="font-mono text-[0.7rem] tracking-wider text-muted uppercase">{fact.label}</dt>
                <dd class="mt-1.5 font-medium">{fact.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <!-- Research -->
  <section id="research" class="container-page scroll-mt-20 py-16 sm:py-24">
    <SectionHeading index="02" label="Research" title="Published work." />
    <div class="space-y-6">
      {
        publications.map((pub) => (
          <div data-reveal>
            <article class="card group overflow-hidden p-6 sm:p-8" data-tilt>
              <div class="pointer-events-none absolute -top-20 -right-16 size-56 rounded-full bg-accent-2/15 blur-3xl" aria-hidden="true" />
              <div class="flex flex-col gap-6 sm:flex-row sm:items-start">
                <div class="grid size-14 shrink-0 place-items-center rounded-2xl border border-accent/40 bg-accent-soft text-accent">
                  <Icon name="paper" size={26} />
                </div>
                <div class="min-w-0 flex-1">
                  <p class="font-mono text-xs text-muted">
                    <span class="text-accent">{pub.venue}</span> · {pub.year} · {pub.details}
                  </p>
                  <h3 class="mt-3 text-xl font-semibold tracking-tight text-balance sm:text-2xl">
                    <a href={pub.url} class="transition-colors hover:text-accent">{pub.title}</a>
                  </h3>
                  <p class="mt-3 text-sm text-muted">
                    {pub.authors.map((author, n) => (
                      <>
                        <span class:list={[author === authorName && 'font-semibold text-ink underline decoration-accent decoration-2 underline-offset-4']}>
                          {author}
                        </span>
                        {n < pub.authors.length - 1 && ', '}
                      </>
                    ))}
                  </p>
                  <p class="mt-4 text-muted text-pretty">{pub.summary}</p>
                  <div class="mt-6 flex flex-wrap gap-3">
                    <a href={pub.url} class="btn-primary">
                      Read the paper
                      <Icon name="arrow-up-right" size={16} />
                    </a>
                    {pub.code && (
                      <a href={pub.code} class="btn-ghost">
                        <Icon name="github" size={16} /> Source code
                      </a>
                    )}
                  </div>
                </div>
              </div>
            </article>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Experience -->
  <section id="experience" class="container-page scroll-mt-20 py-16 sm:py-24">
    <SectionHeading index="03" label="Experience" title="Where I've worked." />
    <ol class="relative space-y-6 before:absolute before:top-2 before:bottom-2 before:left-[1.35rem] before:w-px before:bg-gradient-to-b before:from-accent before:via-accent-2/50 before:to-transparent sm:before:left-[1.6rem]">
      {
        experiences.map((job) => (
          <li class="relative grid grid-cols-[2.75rem_1fr] gap-4 sm:grid-cols-[3.25rem_1fr] sm:gap-6" data-reveal>
            <div
              class:list={[
                'relative z-10 grid size-11 place-items-center overflow-hidden rounded-xl border bg-white sm:size-13',
                job.current ? 'pulse-ring border-accent' : 'border-line',
              ]}
            >
              {job.logo ? (
                <Image src={job.logo} alt="" width={96} class="size-full object-contain p-1.5" />
              ) : (
                <span class="font-mono text-[0.7rem] font-bold tracking-tight text-[#15171c] sm:text-xs">
                  {job.company.slice(0, 3).toUpperCase()}
                </span>
              )}
            </div>
            <article class="card p-5 sm:p-7" data-tilt>
              <header class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
                <div>
                  <h3 class="text-lg font-semibold tracking-tight">{job.role}</h3>
                  <p class="text-muted">{job.company}</p>
                </div>
                <p class="flex shrink-0 items-center gap-2 font-mono text-xs text-muted">
                  {job.current && <span class="rounded-full bg-accent-soft px-2 py-0.5 text-accent">Now</span>}
                  {job.period}
                </p>
              </header>
              <p class="mt-4 text-pretty">{job.summary}</p>
              {job.products && (
                <div class="mt-4">
                  <p class="font-mono text-[0.7rem] tracking-wider text-muted uppercase">Products</p>
                  <ul class="mt-2 flex flex-wrap gap-2">
                    {job.products.map((name) => (
                      <li class="rounded-lg border border-accent/40 bg-accent-soft px-3 py-1 text-sm font-medium">{name}</li>
                    ))}
                  </ul>
                </div>
              )}
              {job.highlights && (
                <ul class="mt-4 space-y-2 text-[0.95rem] text-muted">
                  {job.highlights.map((h) => (
                    <li class="relative pl-5 text-pretty before:absolute before:top-[0.7em] before:left-0 before:h-px before:w-2.5 before:bg-accent">
                      {h}
                    </li>
                  ))}
                </ul>
              )}
              {job.stack && (
                <ul class="mt-5 flex flex-wrap gap-1.5" aria-label="Tech stack">
                  {job.stack.map((s) => (
                    <li class="chip">{s}</li>
                  ))}
                </ul>
              )}
            </article>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Projects -->
  <section id="projects" class="container-page scroll-mt-20 py-16 sm:py-24">
    <SectionHeading index="04" label="Projects" title="Things I've built." />
    <div data-reveal>
      <ProjectCard project={featuredProject} featured />
    </div>

    {
      otherProjects.length > 0 && (
        <div class="mt-6">
          <div class="flex justify-center" data-reveal>
            <button
              type="button"
              class="btn-ghost"
              aria-expanded="false"
              aria-controls="more-projects"
              data-projects-toggle
            >
              <span data-when="closed">Show {otherProjects.length} more projects</span>
              <span data-when="open" hidden>
                Hide projects
              </span>
              <Icon name="chevron-down" size={16} class="transition-transform duration-300 [[aria-expanded=true]>&]:rotate-180" />
            </button>
          </div>
          <div id="more-projects" class="collapse-panel" data-open="false" inert>
            <div class="-mx-2 px-2">
              <div class="grid gap-6 pt-6 pb-2 md:grid-cols-2 lg:grid-cols-3">
                {otherProjects.map((project, i) => (
                  <div data-reveal style={`--reveal-delay:${(i % 3) * 100}ms`}>
                    <ProjectCard project={project} />
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      )
    }
    <p class="mt-8 text-sm text-muted" data-reveal>
      More on <a href={profile.github} class="link text-ink">github.com/{profile.handle}</a>.
    </p>
  </section>

  <!-- Skills -->
  <section id="skills" class="container-page scroll-mt-20 py-16 sm:py-24">
    <SectionHeading index="05" label="Toolbox" title="What I work with." />
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        skills.map((group, i) => (
          <div data-reveal style={`--reveal-delay:${(i % 4) * 80}ms`}>
            <div class="card h-full p-6" data-tilt>
              <h3 class="font-mono text-xs tracking-wider text-accent uppercase">{group.group}</h3>
              <ul class="mt-4 flex flex-wrap gap-2">
                {group.items.map((item) => (
                  <li class="rounded-lg border border-line bg-surface-2/60 px-2.5 py-1 text-sm font-medium transition-colors hover:border-accent hover:text-accent">
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Writing -->
  <section id="writing" class="container-page scroll-mt-20 py-16 sm:py-24">
    <SectionHeading index="06" label="Writing" title="Notes from the backend.">
      <p class="max-w-2xl text-muted">
        Write-ups on system design, architecture and whatever I'm learning at the moment.
      </p>
    </SectionHeading>
    {
      latestPosts.length > 0 ? (
        <div class="card px-5 sm:px-7" data-reveal>
          <div class="divide-y divide-line">
            {latestPosts.map((post) => (
              <PostCard post={post} />
            ))}
          </div>
        </div>
      ) : (
        <p class="text-muted" data-reveal>First post coming soon.</p>
      )
    }
    <div class="mt-8" data-reveal>
      <a href={url('blog/')} class="btn-ghost">
        All posts
        <Icon name="arrow-right" size={16} />
      </a>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="container-page scroll-mt-20 py-16 sm:py-24">
    <div data-reveal>
      <div class="card overflow-hidden rounded-3xl px-6 py-14 text-center sm:px-12 sm:py-20">
        <div class="pointer-events-none absolute inset-0" aria-hidden="true">
          <div class="absolute -top-24 left-1/2 h-64 w-[36rem] -translate-x-1/2 rounded-full bg-accent/25 blur-3xl"></div>
          <div class="absolute -bottom-24 -left-10 h-56 w-72 rounded-full bg-accent-2/20 blur-3xl"></div>
          <div class="absolute -right-10 -bottom-24 h-56 w-72 rounded-full bg-accent-3/20 blur-3xl"></div>
        </div>
        <p class="eyebrow relative">07 · Contact</p>
        <h2 class="relative mx-auto mt-4 max-w-2xl text-3xl font-semibold tracking-tight text-balance sm:text-5xl">
          Have a project or a role in mind? <span class="text-gradient">Let's talk.</span>
        </h2>
        <p class="relative mx-auto mt-5 max-w-lg text-muted text-pretty">
          My inbox is open. Whether it's a question, an opportunity or just a hello, I'll get back to you.
        </p>
        <div class="relative mt-9 flex flex-wrap items-center justify-center gap-3">
          <a href={`mailto:${profile.email}`} class="btn-primary">
            <Icon name="mail" size={16} />
            {profile.email}
          </a>
          <button type="button" class="btn-ghost" data-copy={profile.email}>
            <span data-copy-label class="inline-flex items-center gap-2"><Icon name="copy" size={16} /> Copy email</span>
            <span data-copy-done class="hidden items-center gap-2 text-accent"><Icon name="check" size={16} /> Copied</span>
          </button>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
      } catch {
        return;
      }
      const label = button.querySelector('[data-copy-label]');
      const done = button.querySelector('[data-copy-done]');
      label?.classList.add('hidden');
      done?.classList.replace('hidden', 'inline-flex');
      setTimeout(() => {
        label?.classList.remove('hidden');
        done?.classList.replace('inline-flex', 'hidden');
      }, 1800);
    });
  });

  // Show / hide the secondary projects.
  const toggle = document.querySelector<HTMLButtonElement>('[data-projects-toggle]');
  const panel = document.getElementById('more-projects');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(open));
    toggle.querySelector('[data-when="closed"]')?.toggleAttribute('hidden', open);
    toggle.querySelector('[data-when="open"]')?.toggleAttribute('hidden', !open);
    panel?.setAttribute('data-open', String(open));
    panel?.toggleAttribute('inert', !open);
  });

  // Typewriter for the hero "~$ building …" line.
  const typed = document.querySelector<HTMLElement>('[data-typed]');
  if (typed && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const words: string[] = JSON.parse(typed.dataset.typed ?? '[]');
    let word = 0;
    let chars = words[0].length;
    let deleting = true;
    const tick = () => {
      const current = words[word];
      chars += deleting ? -1 : 1;
      typed.textContent = current.slice(0, chars);
      let delay = deleting ? 45 : 85;
      if (!deleting && chars === current.length) {
        deleting = true;
        delay = 1800;
      } else if (deleting && chars === 0) {
        deleting = false;
        word = (word + 1) % words.length;
        delay = 350;
      }
      setTimeout(tick, delay);
    };
    setTimeout(tick, 2200);
  }
</script>
