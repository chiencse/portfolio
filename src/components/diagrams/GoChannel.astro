---
const rows = [
  { title: 'Unbuffered', code: 'make(chan T)', slots: 0, filled: 0, note: 'gửi chặn tới khi có người nhận — bàn giao trực tiếp' },
  { title: 'Buffered', code: 'make(chan T, 3)', slots: 3, filled: 2, note: 'gửi chỉ chặn khi buffer đầy, nhận chỉ chặn khi rỗng' },
];
---

<svg viewBox="0 0 720 250" role="img" aria-label="So sánh channel không buffer và có buffer">
  <defs>
    <marker id="gc-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" class="head-accent"></path>
    </marker>
  </defs>
  {
    rows.map((row, r) => {
      const y = 14 + r * 118;
      return (
        <g>
          <text x="16" y={y + 26} class="t">
            {row.title}
          </text>
          <text x="16" y={y + 46} class="s mono">
            {row.code}
          </text>

          <rect x="176" y={y + 8} width="112" height="48" rx="10" class="box-info" />
          <text x="232" y={y + 30} text-anchor="middle" class="c">
            goroutine A
          </text>
          <text x="232" y={y + 47} text-anchor="middle" class="s mono">
            ch &lt;- v
          </text>

          <rect x="318" y={y + 12} width="208" height="40" rx="20" class="box-ghost" />
          {row.slots === 0 ? (
            <line x1="330" y1={y + 32} x2="512" y2={y + 32} class="edge-accent flow" marker-end="url(#gc-arrow)" />
          ) : (
            Array.from({ length: row.slots }, (_, i) => (
              <rect
                x={350 + i * 52}
                y={y + 18}
                width="44"
                height="28"
                rx="7"
                class={i >= row.slots - row.filled ? 'box-accent' : 'box'}
              />
            ))
          )}

          <rect x="556" y={y + 8} width="112" height="48" rx="10" class="box-alt" />
          <text x="612" y={y + 30} text-anchor="middle" class="c">
            goroutine B
          </text>
          <text x="612" y={y + 47} text-anchor="middle" class="s mono">
            v := &lt;-ch
          </text>

          <text x="422" y={y + 84} text-anchor="middle" class="s">
            {row.note}
          </text>
        </g>
      );
    })
  }
</svg>
