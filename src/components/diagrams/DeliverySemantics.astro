---
const lanes = [
  {
    title: 'At-most-once',
    sub: 'commit trước, xử lý sau',
    steps: [
      { text: 'Nhận message', cls: 'box' },
      { text: 'Commit offset', cls: 'box' },
      { text: '✕ crash khi xử lý', cls: 'box-warn' },
    ],
    result: { text: 'mất message', cls: 'box-warn', fill: 'fill-warn' },
  },
  {
    title: 'At-least-once',
    sub: 'xử lý trước, commit sau',
    steps: [
      { text: 'Nhận message', cls: 'box' },
      { text: 'Xử lý xong', cls: 'box' },
      { text: '✕ crash trước commit', cls: 'box-warn' },
    ],
    result: { text: 'xử lý lại → trùng', cls: 'box-alt', fill: 'fill-alt' },
  },
  {
    title: 'Exactly-once (hiệu quả)',
    sub: 'at-least-once + idempotent',
    steps: [
      { text: 'Nhận message', cls: 'box' },
      { text: 'Xử lý + ghi dedupe', cls: 'box-accent' },
      { text: 'Commit offset', cls: 'box' },
    ],
    result: { text: 'trùng → bỏ qua', cls: 'box-accent', fill: 'fill-accent' },
  },
];
const stepX = [196, 326, 456];
---

<svg viewBox="0 0 720 290" role="img" aria-label="Ba mức đảm bảo giao nhận: at-most-once, at-least-once và exactly-once hiệu quả">
  <defs>
    <marker id="ds-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" class="head"></path>
    </marker>
  </defs>
  {
    lanes.map((lane, i) => {
      const y = 12 + i * 94;
      return (
        <g>
          <rect x="12" y={y} width="696" height="82" rx="14" class="box-ghost" />
          <text x="28" y={y + 36} class="t">
            {lane.title}
          </text>
          <text x="28" y={y + 56} class="s">
            {lane.sub}
          </text>
          {lane.steps.map((step, j) => (
            <g>
              <rect x={stepX[j]} y={y + 21} width="118" height="40" rx="8" class={step.cls} />
              <text x={stepX[j] + 59} y={y + 46} text-anchor="middle" class="c">
                {step.text}
              </text>
              <line
                x1={stepX[j] + 118}
                y1={y + 41}
                x2={(stepX[j + 1] ?? 586) - 2}
                y2={y + 41}
                class="edge"
                marker-end="url(#ds-arrow)"
              />
            </g>
          ))}
          <rect x="586" y={y + 21} width="110" height="40" rx="8" class={lane.result.cls} />
          <text x="641" y={y + 46} text-anchor="middle" class={`c ${lane.result.fill}`}>
            {lane.result.text}
          </text>
        </g>
      );
    })
  }
</svg>
