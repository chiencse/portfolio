---
interface Props {
  index: string;
  label: string;
  title: string;
}

const { index, label, title } = Astro.props;
---

<div class="mb-10 flex flex-col gap-3" data-reveal>
  <p class="eyebrow flex items-center gap-3">
    <span>{index}</span>
    <span class="h-px w-8 bg-accent/60"></span>
    <span>{label}</span>
  </p>
  <h2 class="text-3xl font-semibold tracking-tight text-balance sm:text-4xl">{title}</h2>
  <slot />
</div>
