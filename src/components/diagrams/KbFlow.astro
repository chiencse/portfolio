---
const steps = [
  { title: 'Nhận task', sub: '“thêm field X”', cls: 'box' },
  { title: 'Đọc AGENTS.md', sub: 'tìm module liên quan', cls: 'box-accent' },
  { title: 'Đọc doc module', sub: 'quy ước, ADR', cls: 'box-info' },
  { title: 'Sửa code + test', sub: 'chạy test để kiểm', cls: 'box-alt' },
  { title: 'Cập nhật doc', sub: 'nếu hành vi đổi', cls: 'box-accent' },
];
---

<svg viewBox="0 0 720 212" role="img" aria-label="Luồng agent dùng knowledge base: nhận task, đọc entry file, đọc doc module, sửa code, cập nhật doc">
  <defs>
    <marker id="kf-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" class="head"></path>
    </marker>
    <marker id="kf-arrow-accent" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" class="head-accent"></path>
    </marker>
  </defs>
  {
    steps.map((step, i) => {
      const x = 12 + i * 141;
      return (
        <g>
          <rect x={x} y="40" width="122" height="66" rx="10" class={step.cls} />
          <text x={x + 61} y="68" text-anchor="middle" class="c">
            {step.title}
          </text>
          <text x={x + 61} y="88" text-anchor="middle" class="s">
            {step.sub}
          </text>
          {i < steps.length - 1 && (
            <line x1={x + 122} y1="73" x2={x + 139} y2="73" class="edge" marker-end="url(#kf-arrow)" />
          )}
        </g>
      );
    })
  }
  <path d="M637,106 V160 H214 V110" class="edge-accent dashed" marker-end="url(#kf-arrow-accent)"></path>
  <text x="425" y="186" text-anchor="middle" class="s">doc đúng hôm nay → task sau đọc ít hơn, đoán ít hơn</text>
</svg>
