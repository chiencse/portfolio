<svg viewBox="0 0 720 280" role="img" aria-label="Cơ chế ETF: nhà đầu tư mua bán trên sàn, thành viên lập quỹ hoán đổi rổ cổ phiếu với quỹ">
  <defs>
    <marker id="em-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" class="head"></path>
    </marker>
    <marker id="em-arrow-accent" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" class="head-accent"></path>
    </marker>
  </defs>

  <text x="140" y="24" text-anchor="middle" class="s mono fill-info">THỊ TRƯỜNG THỨ CẤP (SÀN)</text>
  <rect x="16" y="40" width="248" height="60" rx="12" class="box-info"></rect>
  <text x="140" y="66" text-anchor="middle" class="t">Nhà đầu tư cá nhân</text>
  <text x="140" y="85" text-anchor="middle" class="s">mua bán CCQ ETF như cổ phiếu</text>
  <line x1="140" y1="100" x2="140" y2="140" class="edge" marker-end="url(#em-arrow)" marker-start="url(#em-arrow)"></line>
  <rect x="16" y="142" width="248" height="60" rx="12" class="box"></rect>
  <text x="140" y="168" text-anchor="middle" class="t">Sàn HOSE</text>
  <text x="140" y="187" text-anchor="middle" class="s">lô 100 · ±7% · T+2 · bước giá 10đ</text>

  <text x="560" y="24" text-anchor="middle" class="s mono fill-accent">THỊ TRƯỜNG SƠ CẤP</text>
  <rect x="440" y="40" width="264" height="60" rx="12" class="box-alt"></rect>
  <text x="572" y="66" text-anchor="middle" class="t">Thành viên lập quỹ (AP)</text>
  <text x="572" y="85" text-anchor="middle" class="s">tổ chức lớn, giao dịch theo lô lớn</text>
  <rect x="440" y="142" width="264" height="60" rx="12" class="box-accent"></rect>
  <text x="572" y="168" text-anchor="middle" class="t">Quỹ ETF</text>
  <text x="572" y="187" text-anchor="middle" class="s">giữ rổ cổ phiếu theo chỉ số</text>

  <path d="M540,100 V140" class="edge-accent" marker-end="url(#em-arrow-accent)"></path>
  <text x="532" y="124" text-anchor="end" class="s">rổ cổ phiếu →</text>
  <path d="M604,140 V102" class="edge-accent" marker-end="url(#em-arrow-accent)"></path>
  <text x="612" y="124" class="s">← lô CCQ</text>

  <path d="M264,172 H438" class="edge dashed" marker-end="url(#em-arrow)" marker-start="url(#em-arrow)"></path>
  <text x="351" y="164" text-anchor="middle" class="s">AP mua / bán CCQ trên sàn</text>

  <text x="360" y="236" text-anchor="middle" class="c">Giá ETF &gt; NAV → AP tạo CCQ mới rồi bán ra · Giá &lt; NAV → AP mua CCQ, đổi lấy rổ cổ phiếu</text>
  <text x="360" y="258" text-anchor="middle" class="s">Nhờ kênh chênh lệch giá này, giá ETF thường bám sát NAV — trừ lúc thị trường hoảng loạn</text>
</svg>
