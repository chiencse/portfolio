<svg viewBox="0 0 720 280" role="img" aria-label="Cấu tạo nến Nhật: thân nối giá mở và đóng cửa, bóng nối giá cao nhất và thấp nhất">
  <!-- Bullish candle -->
  <line x1="170" y1="30" x2="170" y2="250" class="line-up" style="stroke-width:2"></line>
  <rect x="140" y="70" width="60" height="130" rx="4" class="fill-up"></rect>
  <text x="120" y="34" text-anchor="end" class="s">Cao nhất</text>
  <text x="120" y="74" text-anchor="end" class="c">Đóng cửa</text>
  <text x="120" y="204" text-anchor="end" class="c">Mở cửa</text>
  <text x="120" y="254" text-anchor="end" class="s">Thấp nhất</text>
  <text x="170" y="274" text-anchor="middle" class="c fill-up">Nến tăng</text>

  <!-- Bearish candle -->
  <line x1="420" y1="40" x2="420" y2="240" class="line-down" style="stroke-width:2"></line>
  <rect x="390" y="80" width="60" height="100" rx="4" class="fill-down"></rect>
  <text x="470" y="44" class="s">Cao nhất</text>
  <text x="470" y="84" class="c">Mở cửa</text>
  <text x="470" y="184" class="c">Đóng cửa</text>
  <text x="470" y="244" class="s">Thấp nhất</text>
  <text x="420" y="274" text-anchor="middle" class="c fill-down">Nến giảm</text>

  <!-- Long lower wick -->
  <line x1="640" y1="70" x2="640" y2="250" class="line-up" style="stroke-width:2"></line>
  <rect x="616" y="70" width="48" height="34" rx="4" class="fill-up"></rect>
  <text x="640" y="274" text-anchor="middle" class="c">Bóng dưới dài</text>
  <text x="640" y="44" text-anchor="middle" class="s">bị bán sâu trong phiên</text>
  <text x="640" y="58" text-anchor="middle" class="s">rồi được mua lên lại</text>

  <text x="290" y="140" text-anchor="middle" class="s">thân = mở ↔ đóng</text>
  <text x="290" y="158" text-anchor="middle" class="s">bóng = cao ↔ thấp</text>
</svg>
