---
const days = [
  { x: 40, title: 'Ngày T', sub: 'lệnh mua khớp', cls: 'box-info' },
  { x: 260, title: 'T+1', sub: 'cổ phiếu đang về', cls: 'box' },
  { x: 480, title: 'T+2', sub: 'về trưa · bán từ phiên chiều', cls: 'box-accent' },
];
---

<svg viewBox="0 0 720 210" role="img" aria-label="Chu kỳ thanh toán T+2: mua ngày T, cổ phiếu về trưa T+2 và bán được từ phiên chiều">
  <defs>
    <marker id="t2-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" class="head"></path>
    </marker>
  </defs>
  {
    days.map((d, i) => (
      <g>
        <rect x={d.x} y="30" width="200" height="64" rx="12" class={d.cls} />
        <text x={d.x + 100} y="56" text-anchor="middle" class="t">
          {d.title}
        </text>
        <text x={d.x + 100} y="77" text-anchor="middle" class="s">
          {d.sub}
        </text>
        {i < days.length - 1 && <line x1={d.x + 200} y1="62" x2={d.x + 218} y2="62" class="edge" marker-end="url(#t2-arrow)" />}
      </g>
    ))
  }
  <rect x="40" y="118" width="440" height="40" rx="10" class="box-warn"></rect>
  <text x="260" y="143" text-anchor="middle" class="c">Chưa bán được: hai phiên giảm sàn liền ≈ −13,5% trên HOSE</text>
  <text x="360" y="190" text-anchor="middle" class="s">Chỉ tính ngày làm việc · mua trước ngày GDKHQ (kể cả đang chờ về) vẫn được nhận cổ tức</text>
</svg>
