---
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import { url } from '@/lib/utils';
---

<Base title="Not found">
  <section class="container-page grid min-h-[60vh] place-content-center py-20 text-center">
    <p class="font-mono text-sm text-accent">404</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">This page doesn't exist.</h1>
    <p class="mt-4 text-muted">It may have moved, or the link might be wrong.</p>
    <div class="mt-8 flex justify-center gap-3">
      <a href={url('/')} class="btn-primary"><Icon name="arrow-left" size={16} /> Home</a>
      <a href={url('blog/')} class="btn-ghost">Blog</a>
    </div>
  </section>
</Base>
