---
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import PostCard from '@/components/PostCard.astro';
import { getPosts, getTags, url } from '@/lib/utils';

const posts = await getPosts();
const tags = getTags(posts);

// Group by year, newest first.
const byYear = Object.entries(
  Object.groupBy(posts, (post) => String(post.data.pubDate.getFullYear())),
).sort(([a], [b]) => Number(b) - Number(a));
---

<Base title="Blog" description="Notes on backend engineering, system design and things I'm learning.">
  <section class="container-page pt-14 pb-10 sm:pt-20">
    <p class="eyebrow" data-reveal>Blog</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight text-balance sm:text-5xl" data-reveal>
      Notes from the backend.
    </h1>
    <p class="mt-5 max-w-2xl text-lg text-muted text-pretty" data-reveal>
      Write-ups on system design, architecture, databases and whatever I'm learning at the moment.
    </p>
    <div class="mt-6 flex flex-wrap items-center gap-3 text-sm" data-reveal>
      <span class="font-mono text-xs text-muted">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</span>
      <a href={url('rss.xml')} class="inline-flex items-center gap-1.5 text-muted hover:text-accent">
        <Icon name="rss" size={15} /> RSS
      </a>
    </div>

    {
      tags.length > 0 && (
        <ul class="mt-8 flex flex-wrap gap-2" aria-label="Tags" data-reveal>
          {tags.map((tag) => (
            <li>
              <a href={url(`blog/tags/${tag.slug}/`)} class="chip transition-colors hover:border-accent hover:text-ink">
                #{tag.name}
                <span class="ml-1.5 opacity-60">{tag.count}</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>

  <section class="container-page">
    {
      posts.length === 0 ? (
        <p class="border-t border-line py-10 text-muted">No posts yet — check back soon.</p>
      ) : (
        byYear.map(([year, items]) => (
          <div class="border-t border-line pt-6 pb-4" data-reveal>
            <h2 class="font-mono text-sm text-muted">{year}</h2>
            <div class="divide-y divide-line">
              {items?.map((post) => (
                <PostCard post={post} />
              ))}
            </div>
          </div>
        ))
      )
    }
  </section>
</Base>
