---
import LineChart from './LineChart.astro';
import { PRICES, rsi } from './techSeries';
---

<LineChart
  label="RSI 14 phiên của chuỗi giá giả lập, với ngưỡng 70 và 30"
  height={200}
  yMin={0}
  yMax={100}
  legend={false}
  series={[{ name: 'RSI(14)', values: rsi(PRICES), cls: 'info' }]}
  hLines={[
    { v: 70, label: '70 · quá mua', cls: 'line-down' },
    { v: 30, label: '30 · quá bán', cls: 'line-up' },
  ]}
  xTicks={[0, 20, 40, 60, 80, 100, 119].map((i) => ({ i, label: `${i}` }))}
  yTicks={[0, 50, 100].map((v) => ({ v, label: `${v}` }))}
/>
